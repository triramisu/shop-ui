# Base URL của API. Mặc định dùng đường dẫn tương đối "/api" để frontend và
# backend chạy cùng origin (qua nginx ở prod/lab, hoặc proxy của Vite ở dev).
# File này chỉ là ví dụ override DEV. Production dùng .env.production và
# bắt buộc /api cùng origin CloudFront, không chấp nhận URL localhost/tuyệt đối.
VITE_API_BASE_URL=/api
# (Chỉ dev) Backend mà Vite dev server proxy tới.
VITE_DEV_API_TARGET=http://localhost:8080
# Public HTTPS backend origin(s), comma-separated. Empty = no payment link.
# Build-time only; never put merchant secrets or action URLs here.
VITE_PAYMENT_ALLOWED_ORIGINS=
