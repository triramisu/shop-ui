# Public build-time configuration for the two-origin CloudFront deployment.
# Browser -> https://aydibro.click/api/* -> CloudFront -> ALB -> backend.
# Never use the private ALB origin, localhost, an EC2 IP or an S3 endpoint here.
VITE_API_BASE_URL=/api
# This only allows a matching backend-issued handoff. It does NOT enable payment.
VITE_PAYMENT_ALLOWED_ORIGINS=https://aydibro.click
